# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campus_laf

# Auth — use a random string of at least 32 characters, never commit real value
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3001
NODE_ENV=development

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:5173
